<%@ page import="javax.servlet.http.HttpSession" %>
<%
    HttpSession sesionSeguridad = request.getSession(false);
    Object idUsuarioSesion = (sesionSeguridad != null) ? sesionSeguridad.getAttribute("idUsuario") : null;
    Object rolSesionActual = (sesionSeguridad != null) ? sesionSeguridad.getAttribute("rolUsuario") : null;

    if (idUsuarioSesion == null) {
        response.sendRedirect(request.getContextPath() + "/login.jsp");
        return;
    }

    if (rolRequerido != null && !rolRequerido.equals(rolSesionActual)) {
        response.sendRedirect(request.getContextPath() + "/login.jsp?error=acceso");
        return;
    }
%>